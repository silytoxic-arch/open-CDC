# Script mode: embeds text files into a C++ source as string chunks.
#   cmake -DOUT=<file.cpp> -DFILES=<a;b;...> -P EmbedFiles.cmake
# Generates opencdc::frontend::detail::kPrimitiveSources (name -> text). Raw
# string literals are split into chunks below MSVC's 16 KB literal limit.
set(_out "// Generated by cmake/EmbedFiles.cmake - do not edit.\n#include \"frontend/Primitives.h\"\n\nnamespace opencdc::frontend::detail {\n\n")
set(_table "")
set(_index 0)
foreach(_file IN LISTS FILES)
    get_filename_component(_name "${_file}" NAME)
    file(READ "${_file}" _text)
    string(LENGTH "${_text}" _len)
    set(_parts "")
    set(_pos 0)
    while(_pos LESS _len)
        math(EXPR _rest "${_len} - ${_pos}")
        if(_rest GREATER 6000)
            set(_rest 6000)
        endif()
        string(SUBSTRING "${_text}" ${_pos} ${_rest} _chunk)
        string(APPEND _parts "    R\"ocdc_embed(${_chunk})ocdc_embed\",\n")
        math(EXPR _pos "${_pos} + ${_rest}")
    endwhile()
    string(APPEND _out "static const char* const kParts${_index}[] = {\n${_parts}};\n")
    string(APPEND _table "    {\"${_name}\", kParts${_index}, sizeof(kParts${_index}) / sizeof(kParts${_index}[0])},\n")
    math(EXPR _index "${_index} + 1")
endforeach()
string(APPEND _out "\nconst EmbeddedSource kPrimitiveSources[] = {\n${_table}};\nconst std::size_t kPrimitiveSourceCount = ${_index};\n\n} // namespace opencdc::frontend::detail\n")
file(WRITE "${OUT}.tmp" "${_out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
