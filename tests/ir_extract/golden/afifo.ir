module sync_r2w#(ASIZE=4)
  output var [4:0] wq2_rptr
  input wire [4:0] rptr
  input wire wclk
  input wire wrst_n
  var [4:0] wq1_rptr
  reg wq1_rptr <= rptr @(posedge wclk) arst(!wrst_n -> 5'b00000)
  reg wq2_rptr <= wq1_rptr @(posedge wclk) arst(!wrst_n -> 5'b00000)
endmodule

module sync_w2r#(ASIZE=4)
  output var [4:0] rq2_wptr
  input wire [4:0] wptr
  input wire rclk
  input wire rrst_n
  var [4:0] rq1_wptr
  reg rq1_wptr <= wptr @(posedge rclk) arst(!rrst_n -> 5'b00000)
  reg rq2_wptr <= rq1_wptr @(posedge rclk) arst(!rrst_n -> 5'b00000)
endmodule

module fifomem#(DSIZE=8, ASIZE=4)
  output wire [7:0] rdata
  input wire [7:0] wdata
  input wire [3:0] waddr
  input wire [3:0] raddr
  input wire wclken
  input wire wfull
  input wire wclk
  var [8 x 16] mem
  cell $dyn_select$0 [8] = dyn_select<8@0:15>(A=mem, S=raddr)
  cell $logic_not$1 [1] = logic_not(A=wfull)
  cell $logic_and$2 [1] = logic_and(A=wclken, B=$logic_not$1)
  cell $dyn_insert$3 [128] = dyn_insert<8@0:15>(A=mem, S=waddr, D=wdata)
  assign rdata = $dyn_select$0
  reg mem <= $dyn_insert$3 @(posedge wclk) en($logic_and$2)
endmodule

module rptr_empty#(ASIZE=4)
  output var rempty
  output wire [3:0] raddr
  output var [4:0] rptr
  input wire [4:0] rq2_wptr
  input wire rinc
  input wire rclk
  input wire rrst_n
  var [4:0] rbin
  wire [4:0] rgraynext
  wire [4:0] rbinnext
  wire rempty_val
  cell $not$0 [5] = not(A={4'b0000, rempty})
  cell $and$1 [5] = and(A={4'b0000, rinc}, B=$not$0)
  cell $add$2 [5] = add(A=rbin, B=$and$1)
  cell $shr$3 [5] = shr(A=rbinnext, B=32'b00000000000000000000000000000001)
  cell $xor$4 [5] = xor(A=$shr$3, B=rbinnext)
  cell $eq$5 [1] = eq(A=rgraynext, B=rq2_wptr)
  assign raddr = rbin[3:0]
  assign rbinnext = $add$2
  assign rgraynext = $xor$4
  assign rempty_val = $eq$5
  reg rptr <= rgraynext @(posedge rclk) arst(!rrst_n -> 5'b00000)
  reg rbin <= rbinnext @(posedge rclk) arst(!rrst_n -> 5'b00000)
  reg rempty <= rempty_val @(posedge rclk) arst(!rrst_n -> 1'b1)
endmodule

module wptr_full#(ASIZE=4)
  output var wfull
  output wire [3:0] waddr
  output var [4:0] wptr
  input wire [4:0] wq2_rptr
  input wire winc
  input wire wclk
  input wire wrst_n
  var [4:0] wbin
  wire [4:0] wgraynext
  wire [4:0] wbinnext
  wire wfull_val
  cell $not$0 [5] = not(A={4'b0000, wfull})
  cell $and$1 [5] = and(A={4'b0000, winc}, B=$not$0)
  cell $add$2 [5] = add(A=wbin, B=$and$1)
  cell $shr$3 [5] = shr(A=wbinnext, B=32'b00000000000000000000000000000001)
  cell $xor$4 [5] = xor(A=$shr$3, B=wbinnext)
  cell $not$5 [2] = not(A=wq2_rptr[4:3])
  cell $eq$6 [1] = eq(A=wgraynext, B={$not$5, wq2_rptr[2:0]})
  assign waddr = wbin[3:0]
  assign wbinnext = $add$2
  assign wgraynext = $xor$4
  assign wfull_val = $eq$6
  reg wptr <= wgraynext @(posedge wclk) arst(!wrst_n -> 5'b00000)
  reg wbin <= wbinnext @(posedge wclk) arst(!wrst_n -> 5'b00000)
  reg wfull <= wfull_val @(posedge wclk) arst(!wrst_n -> 1'b0)
endmodule

module afifo#(DSIZE=8, ASIZE=4)
  output wire [7:0] rdata
  output wire wfull
  output wire rempty
  input wire [7:0] wdata
  input wire winc
  input wire wclk
  input wire wrst_n
  input wire rinc
  input wire rclk
  input wire rrst_n
  wire [3:0] waddr
  wire [3:0] raddr
  wire [4:0] wptr
  wire [4:0] rptr
  wire [4:0] wq2_rptr
  wire [4:0] rq2_wptr
  inst u_sync_r2w : sync_r2w (.wq2_rptr(wq2_rptr), .rptr(rptr), .wclk(wclk), .wrst_n(wrst_n))
  inst u_sync_w2r : sync_w2r (.rq2_wptr(rq2_wptr), .wptr(wptr), .rclk(rclk), .rrst_n(rrst_n))
  inst u_mem : fifomem (.rdata(rdata), .wdata(wdata), .waddr(waddr), .raddr(raddr), .wclken(winc), .wfull(wfull), .wclk(wclk))
  inst u_rptr_empty : rptr_empty (.rempty(rempty), .raddr(raddr), .rptr(rptr), .rq2_wptr(rq2_wptr), .rinc(rinc), .rclk(rclk), .rrst_n(rrst_n))
  inst u_wptr_full : wptr_full (.wfull(wfull), .waddr(waddr), .wptr(wptr), .wq2_rptr(wq2_rptr), .winc(winc), .wclk(wclk), .wrst_n(wrst_n))
endmodule

hierarchy
  afifo (afifo)
    u_sync_r2w (sync_r2w)
    u_sync_w2r (sync_w2r)
    u_mem (fifomem)
    u_rptr_empty (rptr_empty)
    u_wptr_full (wptr_full)
