module tx_domain
  input wire clk_a
  input wire rst_a_n
  output var [7:0] data
  output var valid
  output var [3:0] status
  var [3:0] cnt
  cell $add$0 [4] = add(A=cnt, B=4'b0001)
  cell $eq$1 [1] = eq(A=cnt, B=4'b1111)
  cell $add$2 [8] = add(A=data, B=8'b00000001)
  cell $eq$4 [1] = eq(A=cnt[1:0], B=2'b00)
  cell $eq$5 [1] = eq(A=cnt[1:0], B=2'b01)
  cell $eq$6 [1] = eq(A=cnt[1:0], B=2'b10)
  cell $mux$7 [4] = mux(A=4'b1000, B=4'b0100, S=$eq$6)
  cell $mux$8 [4] = mux(A={$mux$7[3:2], 2'b00}, B=4'b0010, S=$eq$5)
  cell $mux$9 [4] = mux(A={$mux$8[3:1], 1'b0}, B=4'b0001, S=$eq$4)
  reg cnt <= $add$0 @(posedge clk_a) arst(!rst_a_n -> 4'b0000)
  reg valid <= $eq$1 @(posedge clk_a) arst(!rst_a_n -> 1'b0)
  reg data <= $add$2 @(posedge clk_a) arst(!rst_a_n -> 8'b00000000) en($eq$1)
  reg status <= $mux$9 @(posedge clk_a) arst(!rst_a_n -> 4'b0000)
endmodule

module sync_2ff#(RESET_VAL=1'b0)
  input wire clk
  input wire rst_n
  input wire d
  output wire q
  var meta (* ASYNC_REG = "TRUE" *)
  var sync (* ASYNC_REG = "TRUE" *)
  assign q = sync
  reg meta <= d @(posedge clk) arst(!rst_n -> 1'b0)
  reg sync <= meta @(posedge clk) arst(!rst_n -> 1'b0)
endmodule

module rx_domain
  input wire clk_b
  input wire rst_b_n
  input wire [7:0] data_in
  input wire valid_in
  input wire [3:0] status_in
  output var [7:0] data_out
  output wire [3:0] status_out
  wire valid_sync
  reg data_out <= data_in @(posedge clk_b) arst(!rst_b_n -> 8'b00000000) en(valid_sync)
  inst u_valid_sync : sync_2ff (.clk(clk_b), .rst_n(rst_b_n), .d(valid_in), .q(valid_sync))
  inst g_status[0].u_sync : sync_2ff (.clk(clk_b), .rst_n(rst_b_n), .d(status_in[0]), .q(status_out[0]))
  inst g_status[1].u_sync : sync_2ff (.clk(clk_b), .rst_n(rst_b_n), .d(status_in[1]), .q(status_out[1]))
  inst g_status[2].u_sync : sync_2ff (.clk(clk_b), .rst_n(rst_b_n), .d(status_in[2]), .q(status_out[2]))
  inst g_status[3].u_sync : sync_2ff (.clk(clk_b), .rst_n(rst_b_n), .d(status_in[3]), .q(status_out[3]))
endmodule

module top
  input wire clk_a
  input wire rst_a_n
  input wire clk_b
  input wire rst_b_n
  output wire [7:0] data_out
  output wire [3:0] status_out
  wire [7:0] data_a
  wire valid_a
  wire [3:0] status_a
  inst u_tx : tx_domain (.clk_a(clk_a), .rst_a_n(rst_a_n), .data(data_a), .valid(valid_a), .status(status_a))
  inst u_rx : rx_domain (.clk_b(clk_b), .rst_b_n(rst_b_n), .data_in(data_a), .valid_in(valid_a), .status_in(status_a), .data_out(data_out), .status_out(status_out))
endmodule

hierarchy
  top (top)
    u_tx (tx_domain)
    u_rx (rx_domain)
      u_valid_sync (sync_2ff)
      g_status[0].u_sync (sync_2ff)
      g_status[1].u_sync (sync_2ff)
      g_status[2].u_sync (sync_2ff)
      g_status[3].u_sync (sync_2ff)
