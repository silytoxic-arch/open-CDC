# Runs the ```console blocks of a Markdown document (DOC) in WORK: a line
# "$ opencdc ..." is a command (EXE replaces "opencdc"); the lines after it
# are expected output, matched in order against the command's output:
#   "..."            skips any number of lines,
#   "(exit code N)"  the exit code (default 0),
#   other lines      must match one later output line, where "..." inside
#                    the line stands for any text.
# SETUP (optional) is a CMake script run first (e.g. to copy an example).
if(SETUP)
    include("${SETUP}")
endif()
file(STRINGS "${DOC}" lines ENCODING UTF-8)
set(in_block FALSE)
set(commands 0)

function(check_command cmd expected_lines)
    # expected_lines: list with ";" escaped as \x1f
    separate_arguments(args UNIX_COMMAND "${cmd}")
    list(GET args 0 prog)
    if(NOT prog STREQUAL "opencdc")
        message(FATAL_ERROR "only opencdc commands can be run: ${cmd}")
    endif()
    list(REMOVE_AT args 0)
    execute_process(COMMAND "${EXE}" ${args} WORKING_DIRECTORY "${WORK}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(all "${out}${err}")
    string(REPLACE ";" "\x1f" all "${all}")
    string(REPLACE "\r" "" all "${all}")
    string(REPLACE "\n" ";" outlines "${all}")
    list(LENGTH outlines nout)
    set(pos 0)
    set(want_rc 0)
    foreach(exp IN LISTS expected_lines)
        string(REPLACE "\x1f" ";" exp_text "${exp}")
        if(exp_text MATCHES "^\\(exit code ([0-9]+)\\)$")
            set(want_rc "${CMAKE_MATCH_1}")
            continue()
        endif()
        if(exp_text STREQUAL "...")
            continue()
        endif()
        # the line's literal pieces, split at "..."
        string(REPLACE "..." "\x1e" pieces_text "${exp}")
        string(REPLACE ";" "" pieces_text "${pieces_text}")
        set(found FALSE)
        while(pos LESS nout)
            list(GET outlines ${pos} line)
            math(EXPR pos "${pos} + 1")
            # match the pieces in order
            set(rest "${line}")
            set(ok TRUE)
            string(REPLACE "\x1e" ";" plist "${pieces_text}")
            set(first TRUE)
            foreach(piece IN LISTS plist)
                if(piece STREQUAL "")
                    set(first FALSE)
                    continue()
                endif()
                string(FIND "${rest}" "${piece}" at)
                if(at EQUAL -1 OR (first AND NOT at EQUAL 0 AND NOT exp MATCHES "^\\.\\.\\."))
                    set(ok FALSE)
                    break()
                endif()
                string(LENGTH "${piece}" plen)
                math(EXPR cut "${at} + ${plen}")
                string(SUBSTRING "${rest}" ${cut} -1 rest)
                set(first FALSE)
            endforeach()
            if(ok)
                set(found TRUE)
                break()
            endif()
        endwhile()
        if(NOT found)
            string(REPLACE ";" "\n" shown "${outlines}")
            message(FATAL_ERROR "$ ${cmd}\nexpected line not found (in order):\n  ${exp_text}\noutput:\n${shown}")
        endif()
    endforeach()
    if(NOT rc STREQUAL "${want_rc}")
        message(FATAL_ERROR "$ ${cmd}\nexit code ${rc}, the document says ${want_rc}\n${out}${err}")
    endif()
    message("ok: $ ${cmd}")
endfunction()

set(cmd "")
set(expected "")
foreach(raw IN LISTS lines)
    if(NOT in_block)
        if(raw MATCHES "^```console")
            set(in_block TRUE)
        endif()
        continue()
    endif()
    if(raw MATCHES "^```" OR raw MATCHES "^\\$ ")
        if(NOT cmd STREQUAL "")
            check_command("${cmd}" "${expected}")
            math(EXPR commands "${commands} + 1")
        endif()
        set(cmd "")
        set(expected "")
        if(raw MATCHES "^```")
            set(in_block FALSE)
        else()
            string(SUBSTRING "${raw}" 2 -1 cmd)
        endif()
        continue()
    endif()
    string(REPLACE ";" "\x1f" esc "${raw}")
    list(APPEND expected "${esc}")
endforeach()
if(commands EQUAL 0)
    message(FATAL_ERROR "no console commands in ${DOC}")
endif()
message("${commands} command(s) of ${DOC} give the documented output")
